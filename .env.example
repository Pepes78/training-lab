# Configuracion de Supabase (opcional)
#
# Copia este archivo como .env.production y rellena los dos valores. Con esto la
# app queda preconfigurada y quien la use solo tiene que poner su correo, sin
# pegar claves a mano en Ajustes.
#
# SE PUEDEN COMMITEAR. La anon key es publica por diseno: acaba en el JavaScript
# que descarga el navegador, asi que esconderla no aporta seguridad. Lo que
# protege los datos es Row Level Security (ver supabase/schema.sql), que limita
# cada fila a su dueno mediante auth.uid() = user_id.
#
# La clave service_role NUNCA debe salir del panel de Supabase ni aparecer aqui:
# esa si se salta RLS por completo.
#
# Donde encontrarlas: panel de Supabase -> Project Settings -> API

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
