# Configuracion de Supabase para la app publicada.
#
# Estos valores se incrustan en el JavaScript durante el build, de modo que
# cualquiera que abra la app solo tiene que iniciar sesion con su correo: no
# hace falta pegar nada a mano en Ajustes.
#
# Son publicos a proposito. La clave publicable viaja al navegador de todas
# formas; lo que protege los datos es Row Level Security (supabase/schema.sql),
# verificado: una escritura sin sesion es rechazada con
# "42501: new row violates row-level security policy".
#
# La URL es SOLO el origen, sin /rest/v1/: el cliente anade esa ruta por su
# cuenta y duplicarla romperia todas las peticiones.

VITE_SUPABASE_URL=https://gbntgmwjxudpxenqazto.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_0wql3LHaZEPyE-mrCtJoZA_i4RfishT
