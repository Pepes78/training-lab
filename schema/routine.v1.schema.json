{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pepes78.github.io/Training-lab/schema/routine.v1.schema.json",
  "title": "Training Lab — Routine v1",
  "description": "Formato portable de rutina de entrenamiento. Una rutina es una PLANTILLA (que hacer), nunca un registro (que hiciste). La app la instancia en un ciclo con fechas reales y congela una copia dentro, de modo que editar la plantilla mas adelante no reescribe el historial.",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "days"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Identificador estable en kebab-case."
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "author": { "type": "string" },
    "goal": {
      "enum": ["hypertrophy", "strength", "recomp", "endurance", "maintenance"],
      "default": "hypertrophy"
    },
    "experienceLevel": {
      "enum": ["beginner", "intermediate", "advanced"],
      "default": "intermediate"
    },
    "durationWeeks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 52,
      "default": 8,
      "description": "Duracion objetivo del ciclo en semanas."
    },
    "daysPerWeek": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7,
      "description": "Informativo. Si se indica DEBE coincidir con days.length."
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "references": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Justificacion metodologica: estudios, autores o razonamiento."
    },
    "progression": { "$ref": "#/definitions/progression" },
    "deload": { "$ref": "#/definitions/deload" },
    "days": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": { "$ref": "#/definitions/day" }
    },
    "customExercises": {
      "type": "array",
      "items": { "$ref": "#/definitions/exercise" },
      "description": "Ejercicios que no estan en el catalogo base. Permiten que una rutina generada fuera de la app sea autocontenida."
    }
  },

  "definitions": {
    "progression": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["double-progression", "linear", "rir-autoregulated", "none"],
          "default": "double-progression",
          "description": "double-progression: sube el peso cuando alcanzas el tope del rango en TODAS las series prescritas al RIR objetivo."
        },
        "incrementKg": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "upper": { "type": "number", "exclusiveMinimum": 0, "default": 2.5 },
            "lower": { "type": "number", "exclusiveMinimum": 0, "default": 5 },
            "isolation": { "type": "number", "exclusiveMinimum": 0, "default": 1.25 }
          }
        },
        "rirRamp": {
          "type": "array",
          "description": "RIR objetivo semana a semana. Un elemento por semana; si es mas corto que durationWeeks se repite el ultimo valor.",
          "items": {
            "oneOf": [
              { "type": "number", "minimum": 0, "maximum": 6 },
              { "const": "deload" }
            ]
          }
        }
      }
    },

    "deload": {
      "type": "object",
      "required": ["week"],
      "additionalProperties": false,
      "properties": {
        "week": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "const": "last" }
          ],
          "description": "Semana de descarga (1-indexada) o 'last' para la ultima del ciclo."
        },
        "volumeMultiplier": { "type": "number", "minimum": 0.1, "maximum": 1, "default": 0.5 },
        "intensityMultiplier": { "type": "number", "minimum": 0.1, "maximum": 1, "default": 0.9 }
      }
    },

    "day": {
      "type": "object",
      "required": ["id", "name", "order", "blocks"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "type": {
          "enum": ["upper", "lower", "push", "pull", "legs", "full-body", "arms", "chest-back", "custom"],
          "default": "custom"
        },
        "order": { "type": "integer", "minimum": 1 },
        "focus": { "type": "string" },
        "notes": { "type": "string" },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/block" }
        }
      }
    },

    "block": {
      "type": "object",
      "required": ["exercises"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["single", "superset", "circuit"],
          "default": "single",
          "description": "superset y circuit encadenan los ejercicios sin descanso entre ellos."
        },
        "restSec": { "type": "integer", "minimum": 0, "maximum": 600 },
        "label": { "type": "string" },
        "exercises": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/slot" }
        }
      }
    },

    "slot": {
      "type": "object",
      "required": ["slotId", "exerciseId", "sets", "repRange"],
      "additionalProperties": false,
      "properties": {
        "slotId": {
          "type": "string",
          "minLength": 1,
          "description": "UNICO en toda la rutina. Ancla el historial de series: si cambia, se pierde la continuidad de la progresion."
        },
        "exerciseId": {
          "type": "string",
          "minLength": 1,
          "description": "id del catalogo base o de un ejercicio declarado en customExercises."
        },
        "sets": { "type": "integer", "minimum": 1, "maximum": 20 },
        "repRange": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "integer", "minimum": 1 },
          "description": "[minimo, maximo]. Para una cifra exacta usa [10, 10]."
        },
        "targetRIR": {
          "type": "number",
          "minimum": 0,
          "maximum": 6,
          "description": "Si se omite se usa la rampa rirRamp de la rutina."
        },
        "restSec": { "type": "integer", "minimum": 0, "maximum": 600 },
        "tempo": { "type": "string", "description": "excentrica-pausa-concentrica-pausa, ej. '3-1-1-0'." },
        "notes": { "type": "string" },
        "warmupSets": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6,
          "default": 0,
          "description": "No cuentan para el volumen semanal."
        },
        "metric": {
          "enum": ["reps", "seconds"],
          "description": "'seconds' para isometricos como la plancha."
        },
        "perSide": { "type": "boolean", "default": false },
        "substitutions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Alternativas si la maquina esta ocupada. La sustitucion elegida aplica SOLO a la semana en curso."
        },
        "progression": { "$ref": "#/definitions/progression" }
      }
    },

    "muscleContribution": {
      "type": "object",
      "required": ["muscle", "factor"],
      "additionalProperties": false,
      "properties": {
        "muscle": {
          "enum": [
            "chest", "front-delts", "side-delts", "rear-delts", "lats", "upper-back",
            "traps", "lower-back", "biceps", "triceps", "forearms", "quads",
            "hamstrings", "glutes", "adductors", "abductors", "calves", "abs",
            "obliques", "neck"
          ]
        },
        "factor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Cuanto cuenta una serie para este musculo: 1.0 motor primario, 0.5 secundario con estimulo real, 0.25 implicacion menor."
        }
      }
    },

    "exercise": {
      "type": "object",
      "required": ["id", "name", "pattern", "equipment", "primary"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": {
          "type": "object",
          "required": ["es"],
          "additionalProperties": false,
          "properties": {
            "es": { "type": "string", "minLength": 1 },
            "en": { "type": "string", "minLength": 1 }
          }
        },
        "pattern": {
          "enum": [
            "horizontal-push", "vertical-push", "horizontal-pull", "vertical-pull",
            "squat", "hinge", "lunge", "knee-flexion", "knee-extension", "hip-thrust",
            "hip-abduction", "hip-adduction", "elbow-flexion", "elbow-extension",
            "shoulder-abduction", "shoulder-horizontal-abduction", "calf-raise",
            "core-flexion", "core-anti-extension", "core-rotation", "carry", "other"
          ]
        },
        "equipment": {
          "enum": [
            "barbell", "dumbbell", "machine", "cable", "smith", "bodyweight",
            "band", "kettlebell", "ez-bar", "other"
          ]
        },
        "primary": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/muscleContribution" }
        },
        "secondary": {
          "type": "array",
          "items": { "$ref": "#/definitions/muscleContribution" }
        },
        "mediaId": { "type": "string", "description": "id de media en la CDN de ExerciseDB." },
        "isUnilateral": { "type": "boolean", "default": false },
        "defaultMetric": { "enum": ["reps", "seconds"], "default": "reps" },
        "cues": { "type": "array", "items": { "type": "string" } },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "isCustom": { "type": "boolean", "default": false }
      }
    }
  }
}
