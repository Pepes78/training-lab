              "sets": 4,
              "repRange": [8, 10],
              "restSec": 150,
              "warmupSets": 2,
              "perSide": false,
              "substitutions": ["press-pecho-maquina"],
              "notes": "El trabajo pesado de pecho ahora lo hace el Upper con agarre neutro; aqui busca tension y rango."
            },
            {
              "slotId": "d3-s2",
              "exerciseId": "press-pecho-maquina",
              "sets": 3,
              "repRange": [10, 12],
              "restSec": 90,
