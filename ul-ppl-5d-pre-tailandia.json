              "sets": 3,
              "repRange": [12, 15],
              "restSec": 60,
              "warmupSets": 0,
              "perSide": false,
              "substitutions": ["aperturas-mancuernas"]
            },
            {
              "slotId": "d3-s5",
              "exerciseId": "elevaciones-laterales-polea",
              "sets": 4,
              "repRange": [12, 20],
              "restSec": 45,
              "notes": "El deltoides lateral tolera y necesita volumen alto. No busques peso.",
              "warmupSets": 0,
              "perSide": false,
              "substitutions": ["elevaciones-laterales"]
            },
            {
              "slotId": "d3-s6",
              "exerciseId": "triceps-sobre-cabeza",
              "sets": 3,
              "repRange": [10, 12],
              "restSec": 60,
              "notes": "Estancado en 26.25 kg. Busca 12 reps en las 3 series antes de subir 1.25 kg, con pausa de 1 s en el estiramiento.",
              "warmupSets": 0,
              "perSide": false,
              "substitutions": ["copa-triceps", "press-frances"]
            },
            {
              "slotId": "d3-s7",
              "exerciseId": "fondos-paralelas",
              "sets": 3,
              "repRange": [8, 12],
              "restSec": 90,
              "warmupSets": 0,
              "perSide": false,
              "substitutions": ["triceps-polea"],
              "notes": "Baja solo hasta ~90 grados de codo; protege el hombro anterior."
            }
          ]
        }
      ]
    },
