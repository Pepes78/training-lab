              "exerciseId": "sentadilla-maquina",
              "sets": 4,
              "repRange": [8, 12],
              "restSec": 180,
              "warmupSets": 2,
              "perSide": false,
              "substitutions": ["prensa-piernas", "sentadilla-barra"]
            },
