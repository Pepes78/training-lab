              "perSide": false,
              "substitutions": ["cruce-poleas", "aperturas-mancuernas"],
              "notes": "Hiciste 12 reps x3 a 55 kg: sube a 57.5-60 kg."
            },
            {
              "slotId": "d3-s3",
              "exerciseId": "press-hombro-maquina",
              "sets": 3,
              "repRange": [10, 12],
              "restSec": 120,
              "warmupSets": 0,
              "perSide": false,
              "substitutions": ["press-militar-mancuernas"]
            },
            {
              "slotId": "d3-s4",
