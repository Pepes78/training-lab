            },
            {
              "slotId": "d3-s3",
              "exerciseId": "press-hombro-maquina",
              "sets": 3,
              "repRange": [10, 12],
              "restSec": 120,
              "substitutions": ["press-militar-mancuernas"]
            },
            {
