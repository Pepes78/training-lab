{
  "schemaVersion": "1.0",
  "id": "ul-ppl-5d-hipertrofia",
  "name": "Upper/Lower + PPL — 5 dias",
  "description": "Hibrido de tren superior/inferior con enfasis en fuerza los dos primeros dias y bloque Push/Pull/Legs orientado a hipertrofia el resto de la semana. Cada grupo muscular se estimula dos veces por semana, que es la frecuencia con mejor respaldo en la literatura para hipertrofia. Progresion doble con rampa de RIR y descarga en la semana final.",
  "author": "Training Lab — metodologia al estilo Jeff Nippard",
  "goal": "hypertrophy",
  "experienceLevel": "intermediate",
  "durationWeeks": 8,
  "daysPerWeek": 5,
  "tags": ["upper-lower", "ppl", "hipertrofia", "5 dias", "frecuencia 2x"],
  "references": [
    "Frecuencia 2x/semana por grupo muscular: Schoenfeld, Ogborn & Krieger (2016), meta-analisis de frecuencia y hipertrofia",
    "Rango de 5-30 reps con proximidad al fallo suficiente produce hipertrofia similar: Schoenfeld et al. (2021)",
    "Marco de landmarks de volumen (MEV/MAV/MRV): Renaissance Periodization, divulgado por Jeff Nippard"
  ],
  "progression": {
    "type": "double-progression",
    "incrementKg": { "upper": 2.5, "lower": 5, "isolation": 1.25 },
    "rirRamp": [3, 3, 2, 2, 1, 1, 0, "deload"]
  },
  "deload": {
    "week": "last",
    "volumeMultiplier": 0.5,
    "intensityMultiplier": 0.9
  },
  "days": [
    {
      "id": "d1-upper",
      "name": "Upper — Fuerza",
      "type": "upper",
      "order": 1,
      "focus": "Empuje y traccion pesados, rangos bajos",
      "notes": "Dia mas pesado del tren superior. Descansos largos en los dos primeros ejercicios: el objetivo es carga, no bombeo.",
      "blocks": [
        {
          "type": "single",
          "exercises": [
            {
              "slotId": "d1-s1",
              "exerciseId": "press-banca-barra",
              "sets": 4,
              "repRange": [5, 7],
              "restSec": 180,
              "warmupSets": 3,
              "notes": "Movimiento principal. Sube peso solo cuando hagas 7 reps limpias en las 4 series.",
              "substitutions": ["press-inclinado-mancuernas", "press-pecho-maquina"]
            },
            {
              "slotId": "d1-s2",
              "exerciseId": "dominadas",
              "sets": 4,
              "repRange": [6, 8],
              "restSec": 150,
              "warmupSets": 1,
              "notes": "Si superas 8 reps limpias en todas las series, anade lastre.",
              "substitutions": ["dominadas-asistidas", "jalon-amplio"]
            },
            {
              "slotId": "d1-s3",
              "exerciseId": "press-militar-mancuernas",
              "sets": 3,
              "repRange": [8, 10],
              "restSec": 120,
              "substitutions": ["press-hombro-maquina"]
            },
            {
              "slotId": "d1-s4",
              "exerciseId": "remo-barra",
              "sets": 3,
              "repRange": [8, 10],
              "restSec": 120,
              "notes": "Torso a 45 grados. Si la lumbar se resiente, cambia a remo con apoyo.",
              "substitutions": ["remo-mancuerna", "remo-sentado-polea"]
            },
            {
              "slotId": "d1-s5",
              "exerciseId": "elevaciones-laterales",
              "sets": 3,
              "repRange": [12, 15],
              "restSec": 60,
              "substitutions": ["elevaciones-laterales-polea"]
            },
            {
              "slotId": "d1-s6",
              "exerciseId": "curl-ez",
              "sets": 3,
              "repRange": [8, 10],
              "restSec": 90,
              "substitutions": ["curl-barra", "curl-inclinado"]
            },
            {
              "slotId": "d1-s7",
              "exerciseId": "triceps-polea",
              "sets": 3,
              "repRange": [10, 12],
              "restSec": 60,
              "substitutions": ["press-frances", "copa-triceps"]
            }
          ]
        }
      ]
    },
    {
      "id": "d2-lower",
      "name": "Lower — Fuerza",
      "type": "lower",
      "order": 2,
      "focus": "Sentadilla y bisagra de cadera pesadas",
      "notes": "Prioriza la calidad tecnica de la sentadilla. Si llegas con fatiga alta del dia anterior, baja una serie antes que bajar el peso.",
      "blocks": [
        {
          "type": "single",
          "exercises": [
            {
              "slotId": "d2-s1",
              "exerciseId": "sentadilla-barra",
              "sets": 4,
              "repRange": [5, 7],
              "restSec": 210,
              "warmupSets": 3,
              "notes": "Movimiento principal del tren inferior.",
              "substitutions": ["sentadilla-maquina", "prensa-piernas"]
            },
            {
              "slotId": "d2-s2",
              "exerciseId": "peso-muerto-rumano-barra",
              "sets": 3,
              "repRange": [8, 10],
              "restSec": 150,
              "notes": "Baja solo hasta donde mantengas la espalda neutra.",
              "substitutions": ["peso-muerto-rumano"]
            },
            {
              "slotId": "d2-s3",
              "exerciseId": "prensa-piernas",
              "sets": 3,
              "repRange": [10, 12],
              "restSec": 120,
              "substitutions": ["sentadilla-maquina", "zancada-mancuernas"]
            },
            {
              "slotId": "d2-s4",
              "exerciseId": "curl-femoral",
              "sets": 3,
              "repRange": [10, 12],
              "restSec": 90,
              "substitutions": ["curl-femoral-sentado"]
            },
            {
              "slotId": "d2-s5",
              "exerciseId": "elevacion-talones-pie",
              "sets": 4,
              "repRange": [10, 15],
              "restSec": 60,
              "notes": "Pausa de un segundo en el estiramiento de abajo.",
              "substitutions": ["elevacion-talones-sentado", "elevacion-talones"]
            },
            {
              "slotId": "d2-s6",
              "exerciseId": "plancha",
              "sets": 3,
              "repRange": [30, 45],
              "metric": "seconds",
              "restSec": 45,
              "substitutions": ["elevacion-piernas"]
            }
          ]
        }
      ]
    },
    {
